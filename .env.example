# Server-only credentials. Never add NEXT_PUBLIC_ to the API secret.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_ASSET_FOLDER=article-demos/photo-privacy

# Public deployment uses saved, verified fixtures; opt in locally for uploads.
ENABLE_LIVE_UPLOADS=false
